# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# all dotfiles/dot folders, except the ones below
.*
!.gitignore
!.github/
!.dockerignore
!.eslintrc*
!.prettierrc*
!.editorconfig
!.impeccable/
!.superpowers/

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# source assets (not directly used in public/)
assets/project\ pics/

# project docs (design system / strategy — keep local)
/CLAUDE.md
/DESIGN.md
/PRODUCT.md

# AI tooling state and local databases (not for sharing)
.claude/
.claude-flow/
.swarm/
ruvector.db
agentdb.rvf*
